+// the non-power-of-two answer: a texture whose sides are not powers of
+// two is a core feature from gl 2.0 on, and the extensions that carried
+// it before that are the same capability under an older name. asking
+// the version string covers the drivers that made it core without
+// leaving an extension to advertise; asking the extension string covers
+// the 1.x drivers that shipped it as an extension. either one answers
+// yes, and the upload skips the pad.
+//
+// this is the gl twin of the pow2 gate hwd3d.c already runs off the
+// real capability bits: probing beats assuming, because the cost of
+// assuming wrong is not a wrong pixel - it is the padded canvas. a
+// 5712x4284 photo pads to 8192x8192, so the texture and the staging
+// buffer carry 67.1 megapixels to show 24.5, and the gutter copy below
+// writes every one of the other 42.6 million with replicated edge
+// pixels. a driver that could have carried the image exactly pays for
+// 2.7x the canvas.
+static int _viv_gl_probe_npot(void)
+{
+	const GLubyte *version;
+	
+	if (_viv_gl_has_extension("GL_ARB_texture_non_power_of_two"))
+	{
+		return 1;
+	}
+	
+	if (_viv_gl_has_extension("GL_EXT_texture_non_power_of_two"))
+	{
+		return 1;
+	}
+	
+	version = _viv_gl_getstring(GL_VERSION);
+	if (!version)
+	{
+		return 0;
+	}
+	
+	// glGetString(GL_VERSION) answers "major.minor.release ..." with the
+	// profile or the renderer vendor trailing it ("4.6.0 Compatibility
+	// Profile", "2.1 INTEL-945 ..."), so the leading integer is all the
+	// comparison needs.
+	if ((version[0] >= '2') && (version[0] <= '9'))
+	{
+		if (version[1] == '.')
+		{
+			return 1;
+		}
+	}
+	
+	return 0;
+}
+
